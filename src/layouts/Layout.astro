---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const {
  title = "Kin by Chiko",
  description = "Kin by Chiko is the home of Ty Chiko's work as a performer, storyteller, and teacher, helping people find their voice and tell their story.",
  image = "/images/personal/hero-portrait-beanie.jpg",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}${image}`, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Kin by Chiko" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>

  <body>
    <Navbar />
    <slot />
  </body>
</html>