---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Kin by Chiko">
  <main>
    <Hero />

    <section class="home-feature">
      <div class="home-feature-image">
        <img src={`${base}/images/gatherings/gathering-audience-clap.jpg`} alt="The audience applauds at the close of a performance" />
      </div>

      <div class="home-feature-text">
        <p class="eyebrow">Featured Conversation</p>
        <h2>What kind of belonging are we making?</h2>
        <p>
          Longform interviews and visual storytelling rooted in culture, access,
          identity, and creative practice.
        </p>
        <a href={`${base}/stories/`} class="text-link">Explore Stories →</a>
      </div>
    </section>

    <section class="home-mission">
      <p class="eyebrow">Mission</p>
      <h2>
        Story into relationship.<br />
        Relationship into action.
      </h2>
    </section>

    <section class="home-dispatches">
      <div class="section-heading">
        <p class="eyebrow">Latest Dispatches</p>
        <h2>Recent notes from Kin</h2>
      </div>

      <div class="dispatch-grid">
        <article>
          <img src={`${base}/images/community/community-cafe-laugh-bw.jpg`} alt="A woman laughing at an outdoor cafe table" />
          <p class="eyebrow">Interview</p>
          <h3>Creative practice and place</h3>
        </article>

        <article>
          <img src={`${base}/images/community/community-rooftop-group-bw.jpg`} alt="A group of friends, several using mobility aids, gathered together on a rooftop deck" />
          <p class="eyebrow">Dispatch</p>
          <h3>Notes on access and belonging</h3>
        </article>

        <article>
          <img src={`${base}/images/community/community-mural-walk-bw.jpg`} alt="Three friends, two using mobility aids, in conversation outside a mural" />
          <p class="eyebrow">Gathering</p>
          <h3>A table for conversation</h3>
        </article>
      </div>
    </section>


    <section class="home-lessons">
      <div class="home-lessons-text">
        <p class="eyebrow">Private Lessons</p>
        <h2>Study Voice with Chiko.</h2>
        <p>
          Join the conversation and learn to tell your story through
          monologue, public speaking, or song. Private voice lessons welcome
          people living with and without disabilities, at every level of
          ability and experience.
        </p>
        <a href="https://calendar.app.google/nZeLQxmqeVqFcbHu8" class="button primary">Book a Lesson</a>
      </div>

      <div class="home-lessons-image">
        <img src={`${base}/images/chiko-portrait-1-bw.jpg`} alt="Portrait of Chiko" />
      </div>
    </section>

    <section class="home-newsletter">
      <h2>Join the Dispatch.</h2>
      <p>Thoughtful stories, interviews, and gathering notes from Kin.</p>
      <a href={`${base}/newsletter/`} class="button secondary">Subscribe</a>
    </section>
    <footer class="site-footer">
  <div class="footer-nav">
    <a href={`${base}/`}>Studio</a>
    <a href={`${base}/stories/`}>Stories</a>
    <a href={`${base}/gatherings/`}>Gatherings</a>
    <a href={`${base}/about/`}>About</a>
    <a href={`${base}/newsletter/`}>Newsletter</a>
    <a href={`${base}/contact/`}>Contact</a>
  </div>

  <p class="footer-credit">© 2026 Kin by Chiko</p>
</footer>
  </main>
</Layout>