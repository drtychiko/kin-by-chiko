---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Contact | Kin by Chiko"
  description="Get in touch with Ty Chiko about private lessons, masterclasses, or bookings."
>
  <main class="contact-page">
    <section class="contact-hero">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch.</h1>
      <p>
        Questions about private lessons, masterclasses, or bookings?
        Send a message below.
      </p>
    </section>

    <section class="contact-body">
      <form
        class="contact-form"
        action="https://formspree.io/f/xkjgbkzj"
        method="POST"
      >
        <label>
          Name
          <input type="text" name="name" required />
        </label>

        <label>
          Email
          <input type="email" name="email" required />
        </label>

        <label>
          Message
          <textarea name="message" rows="6" required></textarea>
        </label>

        <button type="submit" class="button primary">Send Message</button>
      </form>

      <div class="contact-links">
        <p class="eyebrow">Elsewhere</p>
        <a
          href="https://www.instagram.com/kin_by_chiko"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Instagram →
        </a>
        <a href="https://calendar.app.google/nZeLQxmqeVqFcbHu8" class="text-link">
          Book a Lesson →
        </a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="footer-nav">
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/about/`}>About</a>
        <a href={`${base}/teaching/`}>Teaching</a>
        <a href={`${base}/contact/`}>Contact</a>
      </div>

      <p class="footer-credit">© 2026 Kin by Chiko</p>
    </footer>
  </main>
</Layout>
