---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">Public humanities media studio</p>
    <h1>Story into relationship.</h1>

    <p class="hero-copy">
      Kin by Chiko uses interviews, gatherings, and editorial work to explore
      belonging across culture, access, identity, and creative practice.
    </p>

    <div class="hero-actions">
      <a href={`${base}/stories/`} class="button primary">Explore Stories</a>
      <a href={`${base}/gatherings/`} class="button secondary">View Gatherings</a>
    </div>
  </div>

  <div class="hero-image-wrap">
    <img src={`${base}/images/community/community-mother-daughter-bw.jpg`} alt="A mother and daughter share a warm embrace, laughing together" />
  </div>
</section>