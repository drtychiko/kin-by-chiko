---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">Performance Artist · Storyteller · Teacher</p>
    <h1>Story, on and off stage.</h1>

    <p class="hero-copy">
      Kin by Chiko is home to my work as a performance artist, storyteller,
      and teacher, spanning the concert stage, the classroom, and the
      conversation in between.
    </p>

    <div class="hero-actions">
      <a href={`${base}/teaching/`} class="button primary">View Teaching</a>
      <a href={`${base}/contact/`} class="button secondary">Get in Touch</a>
    </div>
  </div>

  <div class="hero-image-wrap">
    <img src={`${base}/images/personal/hero-portrait-beanie.jpg`} alt="Portrait of Ty Chiko in a beanie and glasses" style="object-position: center 12%;" />
  </div>
</section>
